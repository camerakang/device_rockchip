[Unit]
Description=SS-07 recover confirmed configuration before consumers start
After=local-fs.target systemd-tmpfiles-setup.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=ss07-config
ExecStart=/opt/ss07/current/tools/ss07 recover-active-config --active-config /etc/ss07-active/system.json --journal-dir /var/lib/ss07-apply --state-dir /run/ss07
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/etc/ss07-active /var/lib/ss07-apply
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_OVERRIDE
UMask=0027
